# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Environment / secrets
.env
.env.*
# ...except the template: it holds no secrets, and docs/INSTALL.md tells everyone to
# copy it. `.env.*` above had been hiding it, so the repo never actually shipped it.
!.env.example
*.local
secrets.*

# Local configuration copied from the *.example.json templates
apps.config.json
ops-signals.json

# Logs
*.log
logs/

# Runtime data store (settings, members, ops tasks, patches, worktrees)
data/

# Dependencies. NO trailing slash: a bare `node_modules/` pattern matches a
# directory only, and a node_modules SYMLINK (handy for local testing) is a file,
# so it would sail straight past and get committed.
node_modules
# The ROLLBACK of the last engine update, on a box that has the two-copy deploy
# turned on (PLUMI_LIVE_CLONE). engine-ship.js renames the live tree aside instead
# of deleting it, and the detached watchdog restores it if the server does not come
# back up; it stays until the next update replaces it. `node_modules` does not match
# this name, so without the line a single `git add -A` stages half a gigabyte.
node_modules.previous
__pycache__/
*.py[cod]
.venv/
venv/
target/
dist/
build/

# Misc
*.tmp
.cache/

# Crash dumps (a killed node/chromium leaves these in the cwd)
core
core.*

# built from scripts/supermemory/bind-loopback.c
scripts/supermemory/*.so
