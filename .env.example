# PlumiChat configuration. Copy to `.env` and edit:
#
#     cp .env.example .env
#
# .env is gitignored and must stay that way — it is the only place secrets live.
# EVERY variable here is optional. With an empty .env PlumiChat starts on
# http://localhost:3002 and walks you through creating the owner account.
#
# Full reference, including what each optional feature needs: docs/INSTALL.md


# ─────────────────────────────────────────────────────────────────────────────
# Where it listens
# ─────────────────────────────────────────────────────────────────────────────

PORT=3002

# Loopback by default: only this machine can reach it. This process runs shell
# commands as you, so opening it to the network is a real decision, not a default.
#
# READ THIS BEFORE CHANGING IT: with HOST=0.0.0.0 the server REFUSES to start
# unless AUTH_USER and AUTH_PASS are set, because otherwise the window before your
# owner account exists is an open shell on your network. The recommended way to
# reach it from a phone is a private tunnel (Tailscale/WireGuard) or a reverse
# proxy holding TLS — both of which work with the loopback default. See
# docs/SECURITY.md.
# HOST=127.0.0.1


# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────

# HTTP Basic lifeline. Optional but recommended: it is the recovery path if the
# account system ever locks you out, and it is REQUIRED to bind to anything other
# than loopback. Maps to the owner account.
# AUTH_USER=you
# AUTH_PASS=a-long-random-passphrase

# Signs session cookies. Generated and written back to .env on first boot if unset.
# Changing it signs everyone out.
# SESSION_SECRET=

# How long an invite link stays valid.
# PLUMI_INVITE_TTL_DAYS=7


# ─────────────────────────────────────────────────────────────────────────────
# Where your work lives
# ─────────────────────────────────────────────────────────────────────────────

# The single root every path is contained inside. Owner and admins see all of it;
# each member gets a private home at <root>/.users/<id> and cannot escape it.
# Defaults to ~/projects.
# WORKSPACES_ROOT=/home/you/projects

# Settings, accounts, Operations tasks, patches and caches. Defaults to ./data
# DATA_DIR=./data


# ─────────────────────────────────────────────────────────────────────────────
# The model
# ─────────────────────────────────────────────────────────────────────────────

# The Agent SDK needs credentials. Either set a key here, or sign the bundled CLI
# in to a Claude subscription once (`npx claude login`) and leave this unset.
# ANTHROPIC_API_KEY=

# Defaults when a turn names no model. Model ids, not display names.
# CLAUDE_MODEL=claude-sonnet-5
# TITLE_MODEL=claude-haiku-4-5-20251001
# OPS_MODEL=claude-sonnet-5


# ─────────────────────────────────────────────────────────────────────────────
# Notifications (Web Push)
# ─────────────────────────────────────────────────────────────────────────────

# Generated and saved to .env the first time you enable notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# A REAL contact address. RFC 8292 requires one, and Apple's push service may
# reject pushes signed with a bogus one — so set this before relying on iOS push.
# VAPID_SUBJECT=mailto:you@example.com


# ─────────────────────────────────────────────────────────────────────────────
# Limits
# ─────────────────────────────────────────────────────────────────────────────

# Each turn is a separate ~340 MB process. Size these to your RAM.
# PLUMI_MAX_RUNS=5
# PLUMI_MAX_RUNS_PER_USER=2

# How long an unanswered permission card blocks a turn (default 30 min).
# PLUMI_ASK_TIMEOUT_MS=1800000

# A turn stays open while background work runs, for at most BACKGROUND_MAX_MS after
# its reply; BACKGROUND_WAIT_MS is the silence allowed once it is closing down.
# PLUMI_BACKGROUND_WAIT_MS=900000
# PLUMI_BACKGROUND_MAX_MS=3600000


# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations — all off unless set
# ─────────────────────────────────────────────────────────────────────────────

# External tools, if they are not on PATH. PlumiChat finds them automatically on
# all three platforms; these are the override.
# CHROME_BIN=
# PANDOC_BIN=

# Which PM2 process the in-app Restart button targets. Unset = no restart button.
# PM2_APP_NAME=plumichat

# Extra folders in the terminal's project picker: "Label=/path" pairs, or bare paths.
# PLUMI_TERMINAL_DIRS=Live=/srv/myapp,/home/you/scratch

# A folder the terminal can jump straight into with `claude` running (one tap from
# a slash command). Unset = the button never appears.
# PLUMI_DESIGN_SYNC_DIR=

# A venv's bin/ prepended to each turn's PATH, so the document Skills get their
# python toolchain (python-pptx, openpyxl, reportlab, …).
# PLUMI_DOC_VENV_BIN=/home/you/.venvs/docs/bin

# Operations backend: 'sdk' (in-process, default) or 'native' (a real background
# `claude` session with worktree isolation).
# OPS_RUNNER=sdk
# PLUMI_OPS_CLAUDE_BIN=
# PLUMI_OPS_NATIVE_RESTRICTED=1

# Production error digests injected into scheduled Operations runs. JSON, same
# shape as ops-signals.example.json.
# OPS_SIGNALS=

# Long-term memory: remember across conversations, per account, through a
# Supermemory server (self-hosted or hosted). Unset = off. The key never reaches
# an agent turn. See "Long-term memory" in docs/INSTALL.md.
# PLUMI_MEMORY_URL=http://127.0.0.1:6767
# PLUMI_MEMORY_KEY=sm_...
# Shown in Settings → Memory: where conversation text goes to become memories.
# PLUMI_MEMORY_NOTE=Facts are extracted by <model> through <provider>.
# Ceiling on the per-turn memory lookup, in milliseconds (default 2500).
# PLUMI_MEMORY_RECALL_MS=2500

# The machine card at the top of the side menu (owner only). It needs no setup;
# these only change where it looks.
# Where a Windows CPU temperature comes from: LibreHardwareMonitor's web server.
# Default on Windows and WSL: http://127.0.0.1:8085/data.json. "off" disables it.
# PLUMI_SENSORS_URL=
# What the internet check times TCP handshakes to (IPs, so no DNS is timed).
# "off" disables the check and the connection grade with it.
# PLUMI_NET_TARGETS=1.1.1.1:443,8.8.8.8:443
# The name on the card. Default: the server's time zone, e.g. "Paris, France".
# PLUMI_MACHINE_NAME=


# ─────────────────────────────────────────────────────────────────────────────
# Two-copy deploy — leave unset unless you know you want it
# ─────────────────────────────────────────────────────────────────────────────

# Only for the setup where you EDIT one checkout and SERVE a different one. Unset
# (the normal case) means the Deploy surface reports itself unavailable instead of
# guessing at a path. See docs/INSTALL.md.
# PLUMI_LIVE_CLONE=
# PLUMI_DEV_REPO=
# PLUMI_ENGINE_STAGING=
